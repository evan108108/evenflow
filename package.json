{
  "name": "evenflow",
  "version": "0.0.1",
  "private": true,
  "description": "The Even Flow of Work — a 4a-backed kanban",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan108108/evenflow.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "d1:migrate:local": "wrangler d1 execute evenflow --file=migrations/0001_init.sql --local",
    "d1:migrate:remote": "wrangler d1 execute evenflow --file=migrations/0001_init.sql --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "effect": "^3.11.10",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "wrangler": "^3.99.0"
  }
}
