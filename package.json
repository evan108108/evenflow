{
  "name": "evenflow",
  "version": "0.0.1",
  "private": true,
  "description": "The Even Flow of Work — a 4a-backed kanban",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan108108/evenflow.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "cf-typegen": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply evenflow --local",
    "d1:migrate:remote": "wrangler d1 migrations apply evenflow --remote",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "2.0.0",
    "effect": "^3.11.10",
    "hono": "^4.6.14",
    "nostr-tools": "^2.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "wrangler": "^3.99.0"
  }
}
